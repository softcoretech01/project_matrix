# ==============================================================================
# Backend Environment Template (Copy to .env and fill in values)
# ==============================================================================

# Database Configuration (MySQL Server 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=projectmatrix
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/projectmatrix

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

